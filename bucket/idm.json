{
    "version": "6.43.10",
    "description": "Increase download speeds by up to 5 times, resume and schedule downloads.",
    "homepage": "https://www.internetdownloadmanager.com",
    "license": "Shareware",
    "depends": "sudo",
    "url": "https://download.internetdownloadmanager.com/idman643build10.exe#/idman-install.exe",
    "hash": "a79c0e275750bd9b15f83f1b2d71f4a09eed11a9d903e534448b322db2ed392b",
    "installer": {
        "script": "sudo Start-Process -Wait -PassThru \"$dir\\idman-install.exe\" '/skipdlgs' | Out-Null",
        "keep": true
    },
    "uninstaller": {
        "script": [
            "$running = Get-Process -Name 'IDMan', 'IDMMsgHost' -ErrorAction SilentlyContinue",
            "if ($running) {",
            "    error 'Internet Download Manager is running. Close it, then run scoop uninstall idm again.'",
            "    exit 1",
            "}",
            "$idm = Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'Internet Download Manager'",
            "if (Test-Path \"$idm\\Uninstall.exe\") {",
            "    sudo Start-Process -Wait -PassThru \"$idm\\Uninstall.exe\" '-skdlgs' | Out-Null",
            "}",
            "Get-Process -Name 'IDMan', 'IDMMsgHost', 'IEMonitor', 'idmBroker' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "$clsid = '{CDC95B92-E27C-4745-A8C5-64A52A78855D}'",
            "sudo Remove-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Shell Extensions\\Approved' -Name $clsid -ErrorAction SilentlyContinue",
            "sudo Remove-Item -LiteralPath \"HKLM:\\SOFTWARE\\Classes\\CLSID\\$clsid\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Get-ChildItem 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\ShellIconOverlayIdentifiers' -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -like '*IDM*' } | ForEach-Object { sudo Remove-Item -LiteralPath $_.PSPath -Recurse -Force -ErrorAction SilentlyContinue }",
            "if (Test-Path -LiteralPath $idm) {",
            "    Stop-Process -Name explorer -Force -ErrorAction SilentlyContinue",
            "    Start-Sleep -Seconds 2",
            "    sudo Remove-Item -LiteralPath \"$idm\" -Recurse -Force -ErrorAction SilentlyContinue",
            "    Start-Process explorer.exe",
            "}",
            "$menus = @(",
            "    (Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\Internet Download Manager'),",
            "    (Join-Path $env:ProgramData 'Microsoft\\Windows\\Start Menu\\Programs\\Internet Download Manager')",
            ")",
            "foreach ($menu in $menus) {",
            "    if (Test-Path -LiteralPath $menu) { sudo Remove-Item -LiteralPath \"$menu\" -Recurse -Force -ErrorAction SilentlyContinue }",
            "}",
            "$desktop = Join-Path ([Environment]::GetFolderPath('Desktop')) 'Internet Download Manager.lnk'",
            "if (Test-Path -LiteralPath $desktop) { Remove-Item -LiteralPath $desktop -Force -ErrorAction SilentlyContinue }",
            "$publicDesktop = Join-Path $env:PUBLIC 'Desktop\\Internet Download Manager.lnk'",
            "if (Test-Path -LiteralPath $publicDesktop) { sudo Remove-Item -LiteralPath \"$publicDesktop\" -Force -ErrorAction SilentlyContinue }",
            "$appData = Join-Path $env:APPDATA 'IDM'",
            "if (Test-Path -LiteralPath $appData) { Remove-Item -LiteralPath $appData -Recurse -Force -ErrorAction SilentlyContinue }",
            "$commonData = Join-Path $env:ProgramData 'IDM'",
            "if (Test-Path -LiteralPath $commonData) { sudo Remove-Item -LiteralPath \"$commonData\" -Recurse -Force -ErrorAction SilentlyContinue }",
            "foreach ($key in @(",
            "    'HKCU:\\Software\\DownloadManager',",
            "    'HKLM:\\SOFTWARE\\WOW6432Node\\Internet Download Manager',",
            "    'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Internet Download Manager'",
            ")) {",
            "    if (Test-Path -LiteralPath $key) { sudo Remove-Item -LiteralPath \"$key\" -Recurse -Force -ErrorAction SilentlyContinue }",
            "}",
            "if (Get-Service -Name 'IDMWFP' -ErrorAction SilentlyContinue) {",
            "    sudo sc.exe stop IDMWFP | Out-Null",
            "    sudo sc.exe delete IDMWFP | Out-Null",
            "}",
            "$inf = pnputil.exe /enum-drivers | Select-String -Pattern 'idmwfp\\.inf' -Context 3,0 | ForEach-Object { if ($_.Context.PreContext -match 'oem\\d+\\.inf') { $Matches[0] } } | Select-Object -First 1",
            "if ($inf) { sudo pnputil.exe /delete-driver $inf /force | Out-Null }",
            "$driver = Join-Path $env:WINDIR 'System32\\drivers\\idmwfp.sys'",
            "if (Test-Path -LiteralPath $driver) { sudo Remove-Item -LiteralPath \"$driver\" -Force -ErrorAction SilentlyContinue }"
        ]
    },
    "checkver": {
        "url": "https://www.internetdownloadmanager.com/download.html",
        "regex": "idman(\\d)(\\d{2})build(\\d+)\\.exe",
        "replace": "${1}.${2}.${3}"
    },
    "autoupdate": {
        "url": "https://download.internetdownloadmanager.com/idman$match1$match2build$match3.exe#/idman-install.exe"
    }
}
