{
    "version": "1.5.0",
    "description": "A fast, extensible desktop translation suite with OCR, TTS, spell check and a plugin system.",
    "homepage": "https://qtranslate-app.web.app/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/ahatem/QTranslate/releases/download/v1.5.0/QTranslate-1.5.0-windows-x64.zip",
            "hash": "b406c6817426cdd5d58c5ddc308460c56172cf3e847a844b41cb5f3940b373bc"
        }
    },
    "extract_dir": "QTranslate",
    "shortcuts": [
        [
            "QTranslate.exe",
            "QTranslate"
        ]
    ],
    "persist": [
        "datastore",
        "plugins_data",
        "logs",
        "plugins",
        "themes",
        "languages",
        "icons"
    ],
    "post_install": [
        "@('plugins', 'themes', 'languages', 'icons') | ForEach-Object {",
        "    $new = Join-Path $dir ($_ + '.original')",
        "    if (Test-Path -LiteralPath $new) {",
        "        Copy-Item -Path (Join-Path $new '*') -Destination (Join-Path $dir $_) -Recurse -Force",
        "        Remove-Item -LiteralPath $new -Recurse -Force",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/ahatem/QTranslate"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ahatem/QTranslate/releases/download/v$version/QTranslate-$version-windows-x64.zip"
            }
        }
    }
}
