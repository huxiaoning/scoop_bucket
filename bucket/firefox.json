{
    "version": "155.0",
    "description": "Popular open source web browser.",
    "homepage": "https://www.firefox.com/",
    "license": "MPL-2.0",
    "notes": [
        "Profile 'Scoop' is registered in %APPDATA%\\Mozilla\\Firefox\\profiles.ini and its data lives under persist\\firefox\\profile, so upgrades and uninstalls never lose it.",
        "All launch methods (taskbar pin, shortcut, direct firefox.exe) use this profile automatically - no extra arguments needed.",
        "Verify: open about:profiles and check 'Scoop' is the default profile.",
        "If another Firefox installation (e.g. the official installer) owns the default profile, set 'Scoop' as default manually in about:profiles.",
        "Close Firefox before running scoop update / scoop install -f."
    ],
    "architecture": {
        "64bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/155.0/win64/en-US/Firefox%20Setup%20155.0.exe#/dl.7z",
            "hash": "sha512:64a4fa349a8d58577e7cd43b8c7604e9e9f206c971b4fe8a95010c405f49deb961dab60b94e014af3f4efcf5e6590efcc18ff241e41c658275966a54233acd5d"
        },
        "32bit": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/155.0/win32/en-US/Firefox%20Setup%20155.0.exe#/dl.7z",
            "hash": "sha512:54bb5b9d57ef7668df5e2b5ff0af602a040defec260f39e798140641cb0c3a4de5e9a947003b9653895b6a887a05189ca16d1828610915cec0e49b4f83a8b12a"
        },
        "arm64": {
            "url": "https://archive.mozilla.org/pub/firefox/releases/155.0/win64-aarch64/en-US/Firefox%20Setup%20155.0.exe#/dl.7z",
            "hash": "sha512:5d204ae92696e08b1d2e6be0a120164c94ed99d05bda7e06ae4c8da4a4549749acbaf5d119c1275bafca4eb83c55fc4ad41fa526a46a55a83141f173db8ff1b4"
        }
    },
    "extract_dir": "core",
    "post_install": [
        "$ErrorActionPreference = 'Stop'",
        "$utf8 = New-Object System.Text.UTF8Encoding($false)",
        "$iniDir = \"$env:APPDATA\\Mozilla\\Firefox\"",
        "$ini = Join-Path $iniDir 'profiles.ini'",
        "$profilePath = \"$persist_dir\\profile\"",
        "if (-not (Test-Path $ini)) {",
        "    New-Item -ItemType Directory -Force $iniDir | Out-Null",
        "    $newContent = \"[Profile0]`r`nName=Scoop`r`nIsRelative=0`r`nPath=$profilePath`r`nDefault=1`r`n`r`n[General]`r`nStartWithLastProfile=1`r`nVersion=2`r`n\"",
        "    [System.IO.File]::WriteAllText($ini, $newContent, $utf8)",
        "    info '[Portable Mode]: Registered Scoop profile -> persist\\firefox\\profile'",
        "} else {",
        "    $content = [System.IO.File]::ReadAllText($ini, $utf8)",
        "    $escaped = [regex]::Escape($profilePath)",
        "    if ($content -match \"(?im)^\\s*Path\\s*=\\s*$escaped\\s*$\") {",
        "        info '[Portable Mode]: Scoop profile already registered'",
        "    } else {",
        "        $sections = [regex]::Matches($content, '(?ms)^\\[(Profile\\d+)\\](.*?)(?=^\\[|\\z)')",
        "        $scoopSection = $null",
        "        foreach ($s in $sections) {",
        "            if ($s.Groups[2].Value -match '(?m)^\\s*Name\\s*=\\s*Scoop\\s*$') { $scoopSection = $s; break }",
        "        }",
        "        if ($scoopSection) {",
        "            $oldPathLine = [regex]::Match($scoopSection.Groups[2].Value, '(?m)^\\s*Path\\s*=\\s*(.+?)\\s*$')",
        "            $oldRelLine = [regex]::Match($scoopSection.Groups[2].Value, '(?m)^\\s*IsRelative\\s*=\\s*(\\d)\\s*$')",
        "            $oldDir = $null",
        "            if ($oldPathLine.Success) {",
        "                $oldPath = $oldPathLine.Groups[1].Value",
        "                if ($oldRelLine.Success -and $oldRelLine.Groups[1].Value -eq '1') {",
        "                    $oldDir = Join-Path $iniDir $oldPath",
        "                } else {",
        "                    $oldDir = $oldPath",
        "                }",
        "            }",
        "            if ($oldDir -and (Test-Path $oldDir) -and -not (Test-Path \"$profilePath\\prefs.js\")) {",
        "                New-Item -ItemType Directory -Force $profilePath | Out-Null",
        "                Copy-Item \"$oldDir\\*\" $profilePath -Recurse -Force",
        "                info \"[Portable Mode]: Migrated previous profile data from $oldDir\"",
        "            }",
        "            $newSectionBody = [regex]::Replace($scoopSection.Groups[2].Value, '(?m)^\\s*Path\\s*=.*$', \"Path=$profilePath\")",
        "            $newSectionBody = [regex]::Replace($newSectionBody, '(?m)^\\s*IsRelative\\s*=.*$', 'IsRelative=0')",
        "            if ($newSectionBody -notmatch '(?m)^\\s*Default\\s*=') {",
        "                if ($content -notmatch '(?m)^\\s*Default\\s*=\\s*1\\s*$') { $newSectionBody += \"Default=1`r`n\" }",
        "            }",
        "            $startIdx = $scoopSection.Groups[2].Index",
        "            $endIdx = $startIdx + $scoopSection.Groups[2].Length",
        "            $content = $content.Substring(0, $startIdx) + $newSectionBody + $content.Substring($endIdx)",
        "            [System.IO.File]::WriteAllText($ini, $content, $utf8)",
        "            info '[Portable Mode]: Updated Scoop profile path -> persist\\firefox\\profile'",
        "        } else {",
        "            $maxN = -1",
        "            foreach ($s in $sections) {",
        "                $n = [int]($s.Groups[1].Value -replace '\\D', '')",
        "                if ($n -gt $maxN) { $maxN = $n }",
        "            }",
        "            $newSection = \"`r`n[Profile$($maxN + 1)]`r`nName=Scoop`r`nIsRelative=0`r`nPath=$profilePath`r`n\"",
        "            if ($content -notmatch '(?m)^\\s*Default\\s*=\\s*1\\s*$') { $newSection += \"Default=1`r`n\" }",
        "            $content = $content.TrimEnd() + \"`r`n\" + $newSection",
        "            [System.IO.File]::WriteAllText($ini, $content, $utf8)",
        "            info '[Portable Mode]: Registered Scoop profile in profiles.ini'",
        "        }",
        "    }",
        "}",
        "$Addition = \"$persist_dir\\addition\"",
        "if (Test-Path $Addition) {",
        "  info 'Copying additional items...'",
        "  Copy-Item -Path $Addition\\* -Destination $dir -Force -Recurse -ErrorAction SilentlyContinue",
        "}"
    ],
    "bin": "firefox.exe",
    "shortcuts": [
        [
            "firefox.exe",
            "Firefox"
        ],
        [
            "firefox.exe",
            "Firefox Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution",
        "profile"
    ],
    "checkver": {
        "url": "https://product-details.mozilla.org/1.0/firefox_versions.json",
        "jsonpath": "$.LATEST_FIREFOX_VERSION"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64/en-US/$basename"
                }
            },
            "32bit": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win32/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win32/en-US/$basename"
                }
            },
            "arm64": {
                "url": "https://archive.mozilla.org/pub/firefox/releases/$version/win64-aarch64/en-US/Firefox%20Setup%20$version.exe#/dl.7z",
                "hash": {
                    "url": "https://archive.mozilla.org/pub/firefox/releases/$version/SHA512SUMS",
                    "regex": "$sha512\\s+win64-aarch64/en-US/$basename"
                }
            }
        }
    }
}
