    "installer": {
        "script": [
            "$bundle = Get-ChildItem \"$dir\\*.msixbundle\" | Select-Object -First 1",
            "if (!$bundle) { throw 'Files: MSIX app package (msixbundle) not found.' }",
            "$deps = @(Get-ChildItem \"$dir\\Microsoft.VCLibs*.appx\", \"$dir\\Microsoft.WindowsAppRuntime.2.msix\" -ErrorAction SilentlyContinue)",
            "try {",
            "    Add-AppxPackage -Path $bundle.FullName -DependencyPath $deps.FullName -ForceTargetApplicationShutdown -ForceUpdateFromAnyVersion -ErrorAction Stop",
            "} catch {",
            "    throw \"Files: failed to register the MSIX package ($($bundle.Name)). Install the Windows App Runtime first (scoop install Microsoft.WindowsAppRuntime.2) and retry. $_\"",
            "}"
        ]
    },
    "post_install": [
        "$pkg = Get-AppxPackage -Name Files -ErrorAction SilentlyContinue",
        "if (!$pkg) { throw 'Files: the MSIX package was not registered.' }",
        "$dataDir = Join-Path $env:LOCALAPPDATA \"Packages\\$($pkg.PackageFamilyName)\"",
        "$backup = Join-Path $persist_dir 'AppData'",
        "if (Test-Path $backup) {",
        "    $userFiles = @(Get-ChildItem $dataDir -Recurse -Force -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notlike '*\\Settings\\*' })",
        "    if ($userFiles.Count -eq 0) {",
        "        Remove-Item $dataDir -Recurse -Force -ErrorAction SilentlyContinue",
        "        Move-Item $backup $dataDir -Force",
        "        info 'Restored Files user data from the Scoop persist directory.'",
        "    } else {",
        "        warn \"Existing Files data in $dataDir was kept; the backup at $backup is left untouched.\"",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "$pkg = Get-AppxPackage -Name Files -ErrorAction SilentlyContinue",
            "if (!$pkg) { warn 'Files: no MSIX package registration found, nothing to remove.'; return }",
            "# 升级时不卸载应用包：MSIX 就地更新，用户数据保持不动",
            "if ($version -and $manifest.version -and ($version -ne $manifest.version)) {",
            "    info \"Files: updating $($manifest.version) -> $version, keeping the registered MSIX package (in-place update).\"",
            "    return",
            "}",
            "$dataDir = Join-Path $env:LOCALAPPDATA \"Packages\\$($pkg.PackageFamilyName)\"",
            "$backup = Join-Path $persist_dir 'AppData'",
            "if ($purge) {",
            "    Remove-AppxPackage -Package $pkg.PackageFullName -ErrorAction Stop",
            "} else {",
            "    if (Test-Path $dataDir) {",
            "        $userFiles = @(Get-ChildItem $dataDir -Recurse -Force -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -notlike '*\\Settings\\*' })",
            "        if (($userFiles.Count -gt 0) -or !(Test-Path $backup)) {",
            "            if (Test-Path $backup) { Remove-Item $backup -Recurse -Force }",
            "            ensure $persist_dir | Out-Null",
            "            Move-Item $dataDir $backup -Force",
            "            info \"Moved Files user data to $backup (kept across reinstalls, removed by -p).\"",
            "        }",
            "    }",
            "    Remove-AppxPackage -Package $pkg.PackageFullName -ErrorAction Stop",
            "}"
        ]
    },
