{
    "version": "7.8.27",
    "description": "Open-source terminal AI coding agent from Kilo Code, with 500+ models, BYOK support and sandboxed auto mode.",
    "homepage": "https://kilo.ai/cli",
    "license": "MIT",
    "notes": [
        "首次使用先运行 'kilo' 并执行 'kilo auth login' 登录 Kilo 账号，或用 'kilo auth login <provider>' 配置自己的 API Key。",
        "配置/会话/缓存均存放在用户目录（%USERPROFILE%\\.config\\kilo、.local\\share\\kilo、.local\\state\\kilo、.cache\\kilo），升级和卸载（不带 -p）都不会删除，因此本清单无需 persist。",
        "升级请用 'scoop update kilo'，不要执行 'kilo upgrade'（会绕过 Scoop 覆盖安装目录）。",
        "卸载请用 'scoop uninstall kilo'，不要执行 'kilo uninstall'（它会删除配置与会话数据）。",
        "较老 CPU（不支持 AVX2）若无法启动，请改用 baseline 构建（@kilocode/cli-windows-x64-baseline）。"
    ],
    "suggest": {
        "git": "main/git"
    },
    "architecture": {
        "64bit": {
            "url": "https://registry.npmjs.org/@kilocode/cli-windows-x64/-/cli-windows-x64-7.8.27.tgz",
            "hash": "sha512:e3067703cbe82a2b9dbbf7be440b748c00519dff5e72908f4446607954f862ee2eb8148274a6eef21c69fa0d648a2e06e8ef687861844c6b3e45283cabb193fb"
        },
        "arm64": {
            "url": "https://registry.npmjs.org/@kilocode/cli-windows-arm64/-/cli-windows-arm64-7.8.27.tgz",
            "hash": "sha512:109c17dace343591578f1165bba02f33f76922a276c32845b84309b59ff918195bec9f0c721150c5e491181a0a3292eb114069d3090e472a5d9ca1cd9e9ab7e8"
        }
    },
    "extract_dir": "package\\bin",
    "bin": [
        "kilo.exe",
        [
            "kilo.exe",
            "kilocode"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@kilocode/cli/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://registry.npmjs.org/@kilocode/cli-windows-x64/-/cli-windows-x64-$version.tgz",
                "hash": {
                    "url": "https://registry.npmjs.org/@kilocode/cli-windows-x64/$version",
                    "regex": "sha512-$base64"
                }
            },
            "arm64": {
                "url": "https://registry.npmjs.org/@kilocode/cli-windows-arm64/-/cli-windows-arm64-$version.tgz",
                "hash": {
                    "url": "https://registry.npmjs.org/@kilocode/cli-windows-arm64/$version",
                    "regex": "sha512-$base64"
                }
            }
        }
    }
}
